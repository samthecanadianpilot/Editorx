# EditorX — environment variables template
#
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Set the same variables in Vercel → Project → Settings → Environment Variables
# for the deployed app to work.
#
# Generate SESSION_SECRET with: openssl rand -hex 32

# GitHub OAuth App credentials
#   GH_CLIENT_ID is public; GH_CLIENT_SECRET must never be shared.
#   Get both from: https://github.com/settings/developers → your OAuth App
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# HMAC secret that signs the session cookie. Long random string.
SESSION_SECRET=

# (Optional) Vercel KV for cloud-synced projects. Auto-injected by Vercel
# when you enable KV on the project — uncomment + paste only if running
# `vercel dev` locally and want KV from your machine too.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
